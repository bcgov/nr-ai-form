# ---- System under test: tenant-aware API gateway WebSocket /ws --------------
BACKEND_API_URL=ws://localhost:8000/ws
BACKEND_API_TIMEOUT=180

# Required for gateway requests: an existing tenant client ID and an Origin
# allowed by that tenant's configuration. Random IDs are NOT valid tenant IDs.
BACKEND_WS_CLIENT_ID=
BACKEND_WS_ORIGIN=
BACKEND_WS_STEP=step2-Eligibility
# Use a dedicated test application's ID when evaluating application-specific context.
BACKEND_WS_APPLICATION_ID=234554

# Deployed gateway: set BACKEND_API_URL=wss://<gateway-host>/ws.
# HTTP is only for an explicitly selected legacy /invoke service or the
# tools/local_backend.py stand-in; current master has no orchestrator POST /invoke.
# BACKEND_API_URL=http://localhost:8002

# ---- Judge / grader = GPT-5.1 via Azure AI Foundry (Azure AD / az login) -----
# Auth: run `az login` first. Do NOT set AZURE_OPENAI_API_KEY — the judge and
# promptfoo both fall back to DefaultAzureCredential (your az session).

# Azure AI Foundry project endpoint (V2)
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# Azure OpenAI endpoint (raw OpenAI client uses this)
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
# Bare host (no scheme) for the promptfoo azureopenai provider
AZURE_OPENAI_ENDPOINT_HOST=<your-foundry-resource>.services.ai.azure.com

AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Model deployment used as the grader
FOUNDRY_MODEL=gpt-5.1

# Optional: GPT-5.1 defaults to temperature 1; leave unset unless your
# deployment supports overriding it.
# AZURE_JUDGE_TEMPERATURE=0

# Optional API-key fallback (only if you prefer a key over az login):
# AZURE_OPENAI_API_KEY=your-api-key-here

# ---- Evaluation mode --------------------------------------------------------
# EVAL_LIVE=0  -> offline calibration (grade historical PoC answers from the xlsx)
# EVAL_LIVE=1  -> live (re-run the backend /invoke per case)
EVAL_LIVE=0
# Optional: restrict DeepEval runs to specific canonical steps (comma-separated)
# EVAL_STEPS=step3-Technical-Information,step2-Eligibility
# Optional: enable ToolCorrectnessMetric once /invoke returns tool traces
# EVAL_TOOL_TRACES=0

# ---- PyRIT red-team engine (evaluation/redteam) -----------------------------
# Adversarial (attack-generating) model. Defaults to the GPT-5.1 Foundry judge
# above; leave ADVERSARIAL_API_KEY unset to authenticate with Azure AD (az login).
# ADVERSARIAL_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
# ADVERSARIAL_DEPLOYMENT=gpt-5.1
# ADVERSARIAL_API_VERSION=2025-04-01-preview
# ADVERSARIAL_API_KEY=            # leave empty for az login

# Red-team run defaults
RED_TEAM_THREAT_MODELS=jailbreak,prompt_injection,data_exfiltration
RED_TEAM_MAX_ITERATIONS=5
RED_TEAM_TIMEOUT_SECONDS=300
