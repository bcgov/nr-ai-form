# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Backend API Configuration
BACKEND_API_URL=http://localhost:8000
BACKEND_API_TIMEOUT=30

# Evaluation Configuration
EVALUATION_RUN_NAME=test_evaluation_run
EVALUATION_SCENARIO=basic_evaluation

# Logging
LOG_LEVEL=INFO

# Enabled Evaluators
ENABLED_EVALUATORS=groundedness

# Azure AI Search Configuration (optional - for context retrieval instead of files)
# If not configured, will fallback to file-based context (data/context.json)
AZURE_SEARCH_ENDPOINT=https://your-search-resource.search.windows.net/
AZURE_SEARCH_API_KEY=your-search-api-key-here
AZURE_SEARCH_INDEX_NAME=your-index-name
AZURE_SEARCH_TOP=3
AZURE_SEARCH_TRIM_LENGTH=500
AZURE_SEARCH_ENABLE_TRIMMING=true
AZURE_SEARCH_INCLUDE_TOTAL_COUNT=true
AZURE_SEARCH_QUERY_TYPE=simple
AZURE_SEARCH_SEMANTIC_CONFIGURATION=default
AZURE_SEARCH_QUERY_CAPTION=extractive
AZURE_SEARCH_QUERY_ANSWER=extractive
AZURE_SEARCH_QUERY_ANSWER_COUNT=3
AZURE_SEARCH_QUERY_LANGUAGE=en-us
