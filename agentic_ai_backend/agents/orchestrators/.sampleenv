

CONVERSATION_AGENT_A2A_URL="http://localhost:8000"
FORM_SUPPORT_AGENT_A2A_URL="http://localhost:8001"




CSSAI_EXECUTION_ENV=localhost

#10.0.0.72
REDIS_HOST=10.0.0.71
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=False
REDIS_TTL_DAYS=14

CORS_ALLOW_ORIGINS=""
APPLICATIONINSIGHTS_CONNECTION_STRING=""



# --- Cache TTL (Time To Live) Settings ---
# All values are in seconds. The cache is time-based - it has no awareness of
# blob or Cosmos changes. Updates to prompts or tenant profiles will not take
# effect until the relevant TTL expires.
# Set any value to 0 to disable that cache layer entirely (useful during active
# prompt development so changes take effect immediately on the next request).

# Orchestrator: how long tenant profiles loaded from Cosmos DB are kept in memory.
# Fresh tier - served from memory, no Cosmos read. Default: 300 (5 min)
TENANT_PROFILE_FRESH_TTL_SECONDS=300
# Stale tier - used if Cosmos is temporarily unavailable (outage/timeout). Default: 86400 (24 h)
TENANT_PROFILE_STALE_TTL_SECONDS=86400
# Max time to wait for a Cosmos read before falling back to stale cache. Default: 0.5
TENANT_PROFILE_LOOKUP_TIMEOUT_SECONDS=0.5

# Orchestrator: how long dispatcher/aggregator prompts loaded from blob are cached. Default: 300
ORCHESTRATOR_PROMPT_CACHE_TTL_SECONDS=300


# --- Cosmos DB Client Profiles ---

# Option 1: Endpoint + Key (for emulator AND non-MI Azure environments)
AZURE_COSMOS_DB_ENDPOINT=https://localhost:8081/
AZURE_COSMOS_DB_KEY=

# Option 2: Managed Identity (Azure-hosted dev, test, and production - just set endpoint, no key needed)
# AZURE_COSMOS_DB_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/

# Database name (defaults to AgentMemoryDB if not set)
AZURE_COSMOS_DB_DATABASE_NAME=AgentMemoryDB

# Set to "localhost" to disable TLS verification for the Cosmos emulator and to set "true", just don't set it at all (leave it commented out / remove it)
CSSAI_EXECUTION_ENV=localhost
# Deployment-owned values resolved from environment, not Cosmos DB.
# Keep tenant-specific deployment names, paths, and tuning in Cosmos.
AZURE_OPENAI_ENDPOINT=<azure-openai-endpoint>
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_BLOBSTORAGE_CONNECTIONSTRING=<azure-blob-storage-connection-string>
AZURE_BLOBSTORAGE_CONTAINER=assets
