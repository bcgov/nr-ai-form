
HOST="0.0.0.0"
PORT="8001"


# --- Cache TTL (Time To Live) Settings ---
# How long the fully-built FormSupportAgent (blob reads + OpenAI client) is cached
# per (tenant, step). Set to 0 to disable so prompt changes take effect immediately.
# Default: 300 (5 minutes)
FORM_SUPPORT_AGENT_CACHE_TTL_SECONDS=300

# How long the common instructions blob text is cached independently.
# Default: 300 (5 minutes)
FORM_SUPPORT_PROMPT_CACHE_TTL_SECONDS=300

# Deployment-owned values resolved from environment, not client_settings/Cosmos.
AZURE_OPENAI_ENDPOINT=<azure-openai-endpoint>
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_BLOBSTORAGE_CONNECTIONSTRING=<azure-blob-storage-connection-string>
AZURE_BLOBSTORAGE_CONTAINER=assets
