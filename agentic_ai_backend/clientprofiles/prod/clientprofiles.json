{
    "id": "11111111-1111-4111-8111-111111111111",
    "clientId": "11111111-1111-4111-8111-111111111111",
    "clientName": "Water Permit App",
    "corsOrigins": [
        "http://localhost",
        "https://train.j200.gov.bc.ca",
        "https://test.j200.gov.bc.ca",
        "https://delivery.j200.gov.bc.ca",
        "https://j200.gov.bc.ca"
    ],
    "tenantResources": {
        "prompts": {
            "dispatcher": "tenants/water/agentprompts/dispatcher",
            "aggregator": "tenants/water/agentprompts/aggregrator",
            "edgeCases": "tenants/water/agentprompts/edgecases",
            "gracefulDecline": "tenants/water/agentprompts/gracefuldecline",
            "formMapper": "tenants/water/stepmapper"
        },
        "config": {
            "azureOpenAIChatDeploymentName": "gpt-5.1",
            "azureOpenAIApiVersion": "2024-10-21",
            "azureOpenAIAggregatorChatDeploymentName": "gpt-5.1",
            "azureOpenAIAggregatorMaxCompletionTokens": 2500,
            "formStepNumber": 2,
            "a2aClientTimeoutSeconds": 120,
            "edgeCasePolicy": "custom"
        }
    },
    "subAgents": [
        {
            "agentType": "conversationAgent",
            "enabled": true,
            "promptPath": "tenants/water/agentprompts/conversationagent/instructions.md",
            "config": {
                "azureSearchKnowledgeAgentName": "knowledgebase-bc-waterpermit",
                "agentMaxTokens": 2500,
                "agentTemperature": 0.1,
                "azureSearchIndexName": "rag-bc-waterpermit-indexer",
                "azureSearchKnowledgeAgentApiVersion": "2025-11-01-preview",
                "azureSearchKnowledgeAgentRequestMode": "messages",
                "azureSearchKnowledgeAgentOutputMode": "answerSynthesis",
                "azureSearchKnowledgeAgentReasoningEffort": "low",
                "azureSearchKnowledgeAgentMaxOutputSize": 5000,
                "azureSearchKnowledgeAgentMaxRuntimeSeconds": 30,
                "azureSearchKnowledgeAgentMaxHistoryMessages": 10,
                "azureSearchTop": 5,
                "azureSearchTrimLength": 0,
                "azureSearchEnableTrimming": false,
                "azureSearchIncludeTotalCount": true,
                "azureSearchQueryType": "semantic",
                "azureSearchSemanticConfiguration": "rag-bc-waterpermit-indexer-semantic-configuration",
                "azureSearchQueryCaption": "extractive",
                "azureSearchQueryAnswer": "extractive",
                "azureSearchQueryAnswerCount": 3,
                "azureSearchQueryLanguage": "en-US",
                "conversationAgentMode": "llm",
                "azureOpenaiChatDeploymentName": "gpt-5.1",
                "azureOpenaiApiVersion": "2024-10-21"
            }
        },
        {
            "agentType": "formSupportAgent",
            "enabled": true,
            "promptPath": "tenants/water/agentprompts/formsupportagent/instructions.md",
            "config": {
                "formDefinitionContainer": "tenants/water/formdefinitions",
                "stepBasedPromptContainer": "tenants/water/prompttemplates",
                "azureOpenaiChatDeploymentName": "gpt-5.1",
                "azureOpenaiApiVersion": "2024-10-21",
                "mcpTools": [
                    "LIVESTOCK_WATER_CONSUMPTION_TOOLS"
                ]
            }
        }
    ]

