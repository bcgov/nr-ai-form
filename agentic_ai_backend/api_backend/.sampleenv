# API backend Docker Compose settings. Copy this file to .env before running
# docker compose locally.

# Upstream websocket used by the API backend to call the orchestrator container.
ORCHESTRATOR_AGENT_WS_URL=ws://orchestrator-agent:8002/ws

# Cosmos DB tenant profile lookup. For Azure managed identity, set the endpoint
# and leave AZURE_COSMOS_DB_KEY unset.
AZURE_COSMOS_DB_ENDPOINT=https://azure-cosmos-emulator:8081
AZURE_COSMOS_DB_KEY=<local-cosmos-emulator-key>
AZURE_COSMOS_DB_DATABASE_NAME=AgentMemoryDB

# Set to localhost only for the Cosmos emulator so local TLS verification is disabled.
CSSAI_EXECUTION_ENV=localhost

# Tenant profile cache behavior used by clientprofiles.TenantConfigService.
# FRESH: seconds to serve a tenant profile from this container's memory without re-reading Cosmos.
# STALE: seconds to keep using the last cached profile if Cosmos is temporarily unavailable.
# LOOKUP_TIMEOUT: max seconds to wait for a Cosmos profile read before falling back to stale cache or failing.
# Set a TTL to 0 to disable that cache tier. Code defaults: fresh=300, stale=86400, lookup_timeout=0.5.
TENANT_PROFILE_FRESH_TTL_SECONDS=300
TENANT_PROFILE_STALE_TTL_SECONDS=86400
TENANT_PROFILE_LOOKUP_TIMEOUT_SECONDS=0.5

# Redis is used by the shared thread manager for conversation history/session state.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=False
REDIS_TTL_DAYS=14